# GEMINI_API_KEY: Required for Gemini AI API calls (image/barcode nutrition analysis, comparison, Q&A, TTS).
# Configure this in your hosting provider's Secrets / Environment Variables when exporting/deploying.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# ADMIN_PASSCODE: Optional override for the Admin Portal passcode (defaults to 313178)
ADMIN_PASSCODE="313178"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
